{
  "schemaVersion": 1,
  "id": "tacticalview",
  "version": "${version}",
  "name": "TacticalView",
  "description": "Client-side realistic model rendering framework. Does not change server logic, collisions, health or AI.",
  "authors": [],
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": [
      "tacticalview.fabric.TacticalViewClient"
    ]
  },
  "mixins": [
    {
      "config": "tacticalview.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
